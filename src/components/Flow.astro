---
// 순서가 있는 과정을 상자와 화살표로 보여 준다.
// steps = [{ title, text, sub? }]  (sub: 상자 아래 작은 글씨, 예: 결과물 이름)
interface Props {
	steps: { title: string; text: string; sub?: string }[];
}
const { steps } = Astro.props;
---

<ol class="flow not-content">
	{
		steps.map((step) => (
			<li>
				<strong>{step.title}</strong>
				<span>{step.text}</span>
				{step.sub && <code>{step.sub}</code>}
			</li>
		))
	}
</ol>

<style>
	.flow {
		display: grid;
		grid-auto-flow: column;
		grid-auto-columns: minmax(0, 1fr);
		gap: 1.75rem;
		margin: 1.5rem 0;
		padding: 0;
		list-style: none;
	}
	li {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0.9rem 1rem;
		font-size: var(--sl-text-sm);
		line-height: 1.6;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-nav);
	}
	li:not(:last-child)::after {
		content: '→';
		position: absolute;
		top: 50%;
		right: -1.75rem;
		width: 1.75rem;
		text-align: center;
		transform: translateY(-50%);
		font-size: 1.1rem;
		color: var(--sl-color-text-accent);
	}
	strong {
		font-size: var(--sl-text-base);
		color: var(--sl-color-white);
	}
	code {
		align-self: flex-start;
		margin-top: 0.2rem;
		padding: 0.1rem 0.4rem;
		font-family: var(--__sl-font-mono);
		font-size: 0.8125rem;
		color: var(--sl-color-text-accent);
		border-radius: 0.25rem;
		background: var(--sl-color-accent-low);
	}
	@media (max-width: 50rem) {
		.flow {
			grid-auto-flow: row;
		}
		li:not(:last-child)::after {
			content: '↓';
			top: auto;
			right: auto;
			bottom: -1.75rem;
			left: 50%;
			height: 1.75rem;
			line-height: 1.75rem;
			transform: translateX(-50%);
		}
	}
</style>
